{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Pub Get",
      "type": "shell",
      "command": "flutter",
      "args": ["pub", "get"],
      "group": "build"
    },
    {
      "label": "Flutter: Run",
      "type": "shell",
      "command": "flutter",
      "args": ["run"],
      "isBackground": true,
      "group": "build"
    },
    {
      "label": "Flutter: Analyze",
      "type": "shell",
      "command": "flutter",
      "args": ["analyze"],
      "group": "test"
    },
    {
      "label": "Flutter: Build Debug APK",
      "type": "shell",
      "command": "flutter",
      "args": ["build", "apk", "--debug"],
      "group": "build"
    },
    {
      "label": "Firebase: Projects List",
      "type": "shell",
      "command": "firebase",
      "args": ["projects:list"]
    },
    {
      "label": "Firebase: Deploy Firestore Rules",
      "type": "shell",
      "command": "firebase",
      "args": ["deploy", "--only", "firestore:rules"]
    },
    {
      "label": "Firebase: Deploy Functions",
      "type": "shell",
      "command": "firebase",
      "args": ["deploy", "--only", "functions"]
    },
    {
      "label": "Functions: NPM Install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/functions"
      }
    }
  ]
}
