rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == 'getafricshow1@gmail.com';
    }

    match /verificationDocs/{userId}/{fileName} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024;
    }

    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024;
    }

    match /announcements/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin()
        && request.resource.size < 50 * 1024 * 1024;
    }

    match /listings/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024;
    }

    match /businesses/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
