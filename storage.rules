rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return verified() && request.auth.token.email == 'getafricshow1@gmail.com';
    }

    match /verificationDocs/{userId}/{fileName} {
      allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
