default_platform(:ios)

platform :ios do
  desc "Build the iOS IPA and upload it to TestFlight"
  lane :release do
    repo_root = File.expand_path("../..", __dir__)
    export_options_path = File.expand_path("../ExportOptions.plist", __dir__)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_IDENTIFIER"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
      in_house: false
    )

    sh("which pod")
    sh("pod --version")

    sh("cd \"#{repo_root}\" && flutter build ipa --release --build-number=$GITHUB_RUN_NUMBER --export-options-plist=\"#{export_options_path}\"")

    ipa_path = Dir[File.join(repo_root, "build", "ios", "ipa", "*.ipa")].max_by { |path| File.mtime(path) }
    UI.user_error!("No IPA was generated in build/ios/ipa") unless ipa_path

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: false
    )
  end
end
