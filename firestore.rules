rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == 'getafricshow1@gmail.com';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isGlobalAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isGlobalAdmin());
      allow delete: if signedIn() && (request.auth.uid == userId || isGlobalAdmin());
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if signedIn();
        allow delete: if isSuperAdmin() || isGlobalAdmin();
      }
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update: if signedIn();
        allow delete: if isSuperAdmin() || isGlobalAdmin();
      }
    }

    match /verifications/{verificationId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isGlobalAdmin() || isSuperAdmin());
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == userId;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isGlobalAdmin() || isSuperAdmin());
      }
    }

    match /adminAnnouncements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isGlobalAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSuperAdmin() || isGlobalAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
      }
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /sponsoredBanners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isGlobalAdmin();
    }

    match /publicFeed/{feedId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /{submissionCollection}/{submissionId} {
      allow read: if true;
      allow create: if signedIn()
        && submissionCollection in ['businessSubmissions', 'eventSubmissions', 'communitySubmissions', 'jobSubmissions', 'verificationRequests', 'professionalSubmissions']
        && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if isGlobalAdmin() || isSuperAdmin();
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      match /admins/{adminId} {
        allow read: if true;
        allow create, update, delete: if isGlobalAdmin();
      }
    }

    match /tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || isGlobalAdmin() || isSuperAdmin());
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isGlobalAdmin() || isSuperAdmin()
        || (signedIn() && resource.data.eventAdminIds != null && request.auth.uid in resource.data.eventAdminIds);
      allow delete: if isGlobalAdmin() || isSuperAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      match /admins/{adminId} {
        allow read: if true;
        allow create, update, delete: if isGlobalAdmin();
      }
    }

    match /savedListings/{userId}/items/{itemId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /cashOnDeliveryOrders/{orderId} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid || isSuperAdmin() || isGlobalAdmin());
      allow create: if signedIn() && request.resource.data.paymentMethod == 'cashOnDelivery';
      allow update, delete: if isSuperAdmin() || isGlobalAdmin();
    }

    match /sellerNotifications/{notificationId} {
      allow read: if isSuperAdmin() || isGlobalAdmin();
      allow create: if signedIn() && request.resource.data.type == 'cashOnDeliveryOrder';
      allow update, delete: if isSuperAdmin() || isGlobalAdmin();
    }

    match /adminInvites/{inviteId} {
      allow read: if isSuperAdmin() || isGlobalAdmin() || (signedIn() && resource.data.email == request.auth.token.email);
      allow create, update, delete: if isSuperAdmin() || isGlobalAdmin();
    }

    match /quoteRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read, update: if signedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid || isGlobalAdmin() || isSuperAdmin());
      allow delete: if signedIn() && resource.data.customerId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}
