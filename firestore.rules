rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isGlobalAdmin() {
      return verified()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return verified() && request.auth.token.email == 'getafricshow1@gmail.com';
    }

    function isCommunityAdmin(communityId) {
      return verified()
        && exists(/databases/$(database)/documents/communities/$(communityId)/admins/$(request.auth.uid));
    }

    function isEventAdmin(eventId) {
      return verified()
        && exists(/databases/$(database)/documents/events/$(eventId)/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isGlobalAdmin());
      allow create: if verified() && request.auth.uid == userId;
      allow update: if verified() && (request.auth.uid == userId || isGlobalAdmin());
      allow delete: if verified() && (request.auth.uid == userId || isGlobalAdmin());
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /verifications/{verificationId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if verified() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if verified() && (resource.data.ownerId == request.auth.uid || isGlobalAdmin());
    }

    match /adminAnnouncements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isGlobalAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if verified() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSuperAdmin() || isGlobalAdmin() || (verified() && resource.data.authorId == request.auth.uid);
      }
    }

    match /publicFeed/{feedId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /{submissionCollection}/{submissionId} {
      allow read: if isGlobalAdmin() || isSuperAdmin();
      allow create: if verified()
        && submissionCollection in ['businessSubmissions', 'eventSubmissions', 'communitySubmissions', 'jobSubmissions', 'verificationRequests']
        && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if isGlobalAdmin() || isSuperAdmin();
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      match /admins/{adminId} {
        allow read: if true;
        allow create, update, delete: if isGlobalAdmin();
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      match /admins/{adminId} {
        allow read: if true;
        allow create, update, delete: if isGlobalAdmin();
      }

      match /tickets/{ticketId} {
        allow read: if verified() && (resource.data.buyerId == request.auth.uid || isEventAdmin(eventId) || isGlobalAdmin());
        allow create: if verified() && request.resource.data.buyerId == request.auth.uid;
        allow update: if isEventAdmin(eventId) || isGlobalAdmin();
        allow delete: if isGlobalAdmin();
      }
    }

    match /savedListings/{userId}/items/{itemId} {
      allow read, write: if verified() && request.auth.uid == userId;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if verified() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if verified() && request.resource.data.userId == request.auth.uid;
    }

    match /cashOnDeliveryOrders/{orderId} {
      allow read: if verified() && (resource.data.buyerId == request.auth.uid || isSuperAdmin() || isGlobalAdmin());
      allow create: if signedIn() && request.resource.data.paymentMethod == 'cashOnDelivery';
      allow update, delete: if isSuperAdmin() || isGlobalAdmin();
    }

    match /sellerNotifications/{notificationId} {
      allow read: if isSuperAdmin() || isGlobalAdmin();
      allow create: if signedIn() && request.resource.data.type == 'cashOnDeliveryOrder';
      allow update, delete: if isSuperAdmin() || isGlobalAdmin();
    }

    match /adminInvites/{inviteId} {
      allow read: if isSuperAdmin() || isGlobalAdmin() || (verified() && resource.data.email == request.auth.token.email);
      allow create, update, delete: if isSuperAdmin() || isGlobalAdmin();
    }

    match /chats/{chatId} {
      allow create: if verified() && request.auth.uid in request.resource.data.participants;
      allow read, update, delete: if verified() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if verified()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if verified()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    // Development/testing fallback: any signed-in Firebase Auth user can read/write.
    // Remove this block before production and rely on the stricter collection rules above.
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
